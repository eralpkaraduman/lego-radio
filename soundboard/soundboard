#!/usr/bin/env python3

import glob
import random
import subprocess
import sys
import tty
import termios

SOUNDS_DIR = "sounds"

def get_key():
    """Read a single keypress without waiting for Enter"""
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        key = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    return key

def play_random_sound():
    """Pick and play a random sound file"""
    sound_files = glob.glob(f"{SOUNDS_DIR}/*.mp3")

    if not sound_files:
        print("No sound files found in sounds/")
        return

    sound_file = random.choice(sound_files)
    print(f"Playing: {sound_file.split('/')[-1]}")

    # Play with ffplay, hide banner and auto-close when done
    subprocess.Popen(
        ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", sound_file],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

def main():
    print("Soundboard ready! Press A button (g) to play a random sound, press 'q' to exit.")

    while True:
        key = get_key()

        if key == 'g':
            play_random_sound()
        elif key == 'q':
            print("\nGoodbye!")
            break

if __name__ == "__main__":
    main()
