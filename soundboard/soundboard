#!/usr/bin/env python3

import glob
import os
import random
import subprocess
import sys
import struct
import select
import logging

# Setup logging
logging.basicConfig(level=logging.DEBUG, format='[%(levelname)s] %(message)s')
logger = logging.getLogger(__name__)

SOUNDS_DIR = "sounds"
AUDIO_DEVICE = "dmix:CARD=sndrpihifiberry,DEV=0"  # HifiBerry DAC with dmix (allows parallel playback)
INPUT_DEVICE = "/dev/input/event4"  # 8BitDo controller

# Input event structure format (64-bit Linux)
# struct input_event { struct timeval time; __u16 type; __u16 code; __s32 value; }
EVENT_FORMAT = 'llHHi'
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

# Event types
EV_KEY = 1

# Key codes we're interested in
KEY_G = 34  # A button on controller in K mode

def read_input_event(device_fd):
    """Read a single input event from the device"""
    try:
        data = os.read(device_fd, EVENT_SIZE)
        if len(data) == EVENT_SIZE:
            tv_sec, tv_usec, ev_type, ev_code, ev_value = struct.unpack(EVENT_FORMAT, data)
            return ev_type, ev_code, ev_value
    except Exception as e:
        logger.error(f"Error reading input event: {e}")
    return None, None, None

def play_random_sound():
    """Pick and play a random sound file"""
    sound_files = glob.glob(f"{SOUNDS_DIR}/*.mp3")

    if not sound_files:
        logger.warning("No sound files found in sounds/")
        return

    sound_file = random.choice(sound_files)
    logger.info(f"Playing: {os.path.basename(sound_file)}")

    # Use ffmpeg to play directly to ALSA device with dmix for parallel playback
    cmd = ["ffmpeg", "-i", sound_file, "-f", "alsa", AUDIO_DEVICE]

    logger.debug(f"Command: {' '.join(cmd)}")

    # Play with ffmpeg outputting to ALSA device
    try:
        # Run and wait for completion to capture all output
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10
        )

        logger.debug(f"ffmpeg exit code: {result.returncode}")

        if result.stdout:
            logger.debug(f"ffmpeg stdout:\n{result.stdout.decode('utf-8', errors='ignore')}")
        if result.stderr:
            logger.info(f"ffmpeg stderr:\n{result.stderr.decode('utf-8', errors='ignore')}")

        if result.returncode != 0:
            logger.error(f"ffmpeg failed with exit code {result.returncode}")

    except subprocess.TimeoutExpired:
        logger.error("ffmpeg timeout after 10 seconds")
    except Exception as e:
        logger.error(f"Failed to run ffmpeg: {e}")

def main():
    logger.info("Soundboard starting...")
    logger.info(f"Sounds directory: {SOUNDS_DIR}")
    logger.info(f"Audio device: {AUDIO_DEVICE}")
    logger.info(f"Input device: {INPUT_DEVICE}")

    # Open input device
    try:
        input_fd = os.open(INPUT_DEVICE, os.O_RDONLY | os.O_NONBLOCK)
        logger.info(f"Successfully opened {INPUT_DEVICE}")
    except PermissionError:
        logger.error(f"Permission denied for {INPUT_DEVICE}")
        logger.error("Run: sudo usermod -a -G input $USER")
        logger.error("Then log out and back in")
        sys.exit(1)
    except FileNotFoundError:
        logger.error(f"Device not found: {INPUT_DEVICE}")
        logger.error("Make sure the controller is connected")
        sys.exit(1)

    print("Soundboard ready! Press A button on controller to play a random sound.")
    print("Press Ctrl+C to exit.")

    try:
        while True:
            # Wait for input with timeout
            ready, _, _ = select.select([input_fd], [], [], 0.1)

            if ready:
                ev_type, ev_code, ev_value = read_input_event(input_fd)

                if ev_type is None:
                    continue

                logger.debug(f"Event: type={ev_type}, code={ev_code}, value={ev_value}")

                # Check for key press (EV_KEY type, value=1 means pressed)
                if ev_type == EV_KEY and ev_value == 1:
                    logger.debug(f"Key press detected: code={ev_code}")

                    # A button (KEY_G)
                    if ev_code == KEY_G:
                        logger.info("A button pressed - playing sound")
                        play_random_sound()

    except KeyboardInterrupt:
        logger.info("\nShutting down...")
        print("\nGoodbye!")
    finally:
        os.close(input_fd)

if __name__ == "__main__":
    main()
