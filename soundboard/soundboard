#!/usr/bin/env python3

import glob
import os
import random
import subprocess
import sys
import tty
import termios
import logging

# Setup logging
logging.basicConfig(level=logging.DEBUG, format='[%(levelname)s] %(message)s')
logger = logging.getLogger(__name__)

SOUNDS_DIR = "sounds"
AUDIO_DEVICE = "hw:2,0"  # HifiBerry DAC (same as mopidy)

def get_key():
    """Read a single keypress without waiting for Enter"""
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        key = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    return key

def play_random_sound():
    """Pick and play a random sound file"""
    sound_files = glob.glob(f"{SOUNDS_DIR}/*.mp3")

    if not sound_files:
        logger.warning("No sound files found in sounds/")
        return

    sound_file = random.choice(sound_files)
    logger.info(f"Selected: {sound_file}")

    # Set ALSA device to match mopidy config (hw:2,0 = HifiBerry DAC)
    env = os.environ.copy()
    env["AUDIODEV"] = AUDIO_DEVICE

    # Build ffplay command
    cmd = ["ffplay", "-nodisp", "-autoexit", "-loglevel", "error",
           "-audio_device", AUDIO_DEVICE, sound_file]

    logger.debug(f"Audio device: {AUDIO_DEVICE}")
    logger.debug(f"Command: {' '.join(cmd)}")

    # Play with ffplay using ALSA device
    try:
        process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env
        )
        logger.info(f"Process started with PID: {process.pid}")

        # Log any immediate errors
        stderr = process.stderr.read(100)  # Read first 100 bytes
        if stderr:
            logger.error(f"ffplay stderr: {stderr.decode('utf-8', errors='ignore')}")
    except Exception as e:
        logger.error(f"Failed to start ffplay: {e}")

def main():
    logger.info("Soundboard starting...")
    logger.info(f"Sounds directory: {SOUNDS_DIR}")
    logger.info(f"Audio device: {AUDIO_DEVICE}")
    print("Soundboard ready! Press A button (g) to play a random sound, press 'q' to exit.")

    while True:
        key = get_key()
        logger.debug(f"Key pressed: {repr(key)}")

        if key == 'g':
            logger.info("Play sound triggered")
            play_random_sound()
        elif key == 'q':
            logger.info("Quit requested")
            print("\nGoodbye!")
            break
        else:
            logger.debug(f"Unhandled key: {repr(key)}")

if __name__ == "__main__":
    main()
